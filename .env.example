# ---- LLM provider -------------------------------------------------------
# cloudflare (default) | groq | openai (any OpenAI-compatible server) | scripted (offline demo)
DATABEACON_LLM_PROVIDER=cloudflare

# Cloudflare Workers AI (primary; free tier: 10,000 neurons/day, resets 00:00 UTC)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# DATABEACON_MODEL=@cf/openai/gpt-oss-120b      (default; must support tool calling)
# Behind an egress proxy that injects the Authorization header, leave the token empty and set:
# DATABEACON_INJECTED_AUTH=1

# Free-tier guard: Cloudflare calls stop once this many neurons are used today (UTC)
DATABEACON_CLOUDFLARE_DAILY_NEURONS=9000
# Workers AI defaults to 256 output tokens - too few for a reasoning model
DATABEACON_MAX_OUTPUT_TOKENS=4096
# DATABEACON_REASONING_EFFORT=low               (low | medium | high; lower = fewer neurons)

# Optional fallback provider when Cloudflare fails or the neuron budget is spent
# DATABEACON_FALLBACK_PROVIDER=groq
# GROQ_API_KEY=
# DATABEACON_FALLBACK_MODEL=openai/gpt-oss-120b

# Local / other OpenAI-compatible server, e.g. Ollama
# DATABEACON_LLM_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_API_KEY=ollama
# DATABEACON_MODEL=qwen2.5:14b

# ---- Agent budgets / stopping conditions -------------------------------
DATABEACON_MAX_ITERATIONS=3
DATABEACON_MAX_TOOL_CALLS=24
DATABEACON_MAX_STEPS_PER_ITERATION=8

# ---- Sandbox limits -----------------------------------------------------
DATABEACON_SQL_TIMEOUT_S=15
DATABEACON_SQL_MAX_ROWS=5000
DATABEACON_MAX_UPLOAD_MB=200

# ---- MCP transport: inprocess (fast) | stdio (servers as subprocesses) --
DATABEACON_MCP_TRANSPORT=inprocess

# ---- Observability ------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   (needs opentelemetry-exporter-otlp)
# DATABEACON_OTEL_CONSOLE=1

# ---- Public deployment ---------------------------------------------------
# Turns on per-visitor isolation, stricter limits, 24 h retention, no /docs and
# no internals in error responses. Every limit can still be overridden below.
# DATABEACON_PUBLIC_MODE=1
# DATABEACON_CORS_ORIGINS=https://your-app.vercel.app
# DATABEACON_TRUST_PROXY=1                # only behind a proxy you control
# DATABEACON_DEMO_ACCESS_CODE=            # require a shared code for live AI analyses
# DATABEACON_MAX_UPLOAD_MB=4
# DATABEACON_MAX_ROWS=250000
# DATABEACON_MAX_COLUMNS=100
# DATABEACON_MAX_DATASETS_PER_SESSION=3
# DATABEACON_RUNS_PER_HOUR=3
# DATABEACON_RUNS_PER_DAY=8
# DATABEACON_REQUESTS_PER_MINUTE=120
# DATABEACON_DATA_TTL_HOURS=24
# DATABEACON_DUCKDB_MEMORY_LIMIT=512MB

# ---- Shared storage and serverless execution (Vercel + Cloudflare D1) ----
# Without these, everything is stored in SQLite files under DATABEACON_DATA_DIR (default ./data).
# DATABEACON_STORAGE=d1                     # datasets, runs, events, PDFs, rate limits, neuron ledger in D1
# DATABEACON_D1_DATABASE_ID=
# DATABEACON_D1_API_TOKEN=                  # optional; defaults to CLOUDFLARE_API_TOKEN (needs D1 Edit)
# DATABEACON_DATASET_CACHE_MB=150           # per-instance /tmp cache of rebuilt datasets
# DATABEACON_D1_CHUNK_BYTES=524288          # Parquet chunk size per D1 row (halved automatically if too big)
# DATABEACON_EXECUTION=inline               # inline (run inside the request; default on Vercel) | background
# DATABEACON_RUN_DEADLINE_S=270             # inline: agent wraps up with 75 s left before this
# DATABEACON_RUN_DEADLINE_GRACE_S=20        # inline: hard stop after deadline + grace -> interrupted
# DATABEACON_RUN_STALE_S=120                # no heartbeat this long -> run reported interrupted
# DATABEACON_NEURON_WINDOW=rolling24h       # neuron guard window: rolling24h | utc_day
# DATABEACON_REPLAY_ONLY=1                  # only recorded investigations; live analyses disabled

# ---- Frontend build (Vercel project env) ---------------------------------
# VITE_API_BASE=https://your-backend.example.com   (empty = same origin, as on Vercel)
# VITE_REPO_URL=https://github.com/aekankpatel/queryra
